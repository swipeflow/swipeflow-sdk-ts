{
  "name": "@swipeflow/sdk",
  "version": "0.8.0",
  "description": "TypeScript SDK for SwipeFlow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "fetch-openapi": "node scripts/fetch-openapi-spec.js",
    "generate-api": "rm -rf src/generated && openapi --input ./openapi.json --output ./src/generated --client axios --name SwipeFlowClient && node scripts/patch-generated-index.js",
    "generate": "npm run fetch-openapi && npm run generate-api",
    "build": "rm -rf dist && tsc",
    "prepare": "npm run build",
    "clean": "rm -rf dist openapi.json",
    "prepublishOnly": "npm run generate && git diff --exit-code -- src/generated",
    "publish-dry": "npm pack --dry-run"
  },
  "keywords": [
    "swipeflow",
    "sdk",
    "client",
    "typescript"
  ],
  "author": {
    "name": "SwipeFlow Team",
    "email": "support@swipeflow.io"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swipeflow/swipeflow-ts.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "openapi-typescript-codegen": "^0.27.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
